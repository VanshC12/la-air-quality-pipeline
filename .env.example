# Copy to .env and adjust. Everything has a working local default.

# --- Airflow ---------------------------------------------------------------
# On Linux set this to `id -u` so bind-mounted files are owned by you.
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Any long random string. Shared by the api-server and task runners.
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-long-random-string
# Optional: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Warehouse (Postgres) --------------------------------------------------
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_DB=warehouse
# Host port the warehouse is exposed on (5433 avoids clashing with a local Postgres).
WAREHOUSE_HOST_PORT=5433

# --- Running the CLI / dbt from the host (not inside Docker) ---------------
WAREHOUSE_DSN=postgresql://warehouse:warehouse@localhost:5433/warehouse
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
RAW_DATA_DIR=data/raw
LOCATIONS_CSV=dbt/seeds/locations.csv
DBT_TARGET=dev
